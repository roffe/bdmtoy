<Project Sdk="Microsoft.NET.Sdk">
  <!-- bdmstuff for Windows: WinForms on .NET 10 (x64). USB through LibUsbDotNet 3
       (UsbLink.cs) and the native libusb-1.0.dll next to the exe; the protocol
       core is ../namedll (C++/CLI). Firmware 2.2 and its bootloader have
       Windows load WinUSB on its own (Microsoft OS 2.0 descriptors). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>bdmstuff</RootNamespace>
    <AssemblyName>bdmstuff</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\namedll\namedll.vcxproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- libusb 1.0.30, the official MSVC x64 build (VS2025/MS64) -->
    <None Include="libusb\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
